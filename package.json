{
  "name": "claude-session-visualizer",
  "productName": "Claude Session Visualizer",
  "version": "0.1.1",
  "description": "A visual of a Claude session: agents, skills, tools, API requests, tokens and cost.",
  "main": "./out/main/index.js",
  "author": "Assembler AI LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assemblerai/claude-session-visualizer.git"
  },
  "homepage": "https://github.com/assemblerai/claude-session-visualizer#readme",
  "bugs": {
    "url": "https://github.com/assemblerai/claude-session-visualizer/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
